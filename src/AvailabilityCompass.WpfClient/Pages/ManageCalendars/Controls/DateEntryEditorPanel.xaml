<UserControl x:Class="AvailabilityCompass.WpfClient.Pages.ManageCalendars.Controls.DateEntryEditorPanel"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:controls="clr-namespace:AvailabilityCompass.WpfClient.Shared.Controls"
             x:Name="Root">
    <UserControl.Resources>
        <BooleanToVisibilityConverter x:Key="BooleanToVisibilityConverter" />
    </UserControl.Resources>
    <StackPanel>
        <!-- Editor Header -->
        <Grid Margin="0,0,0,16">
            <TextBlock Text="{Binding Title, ElementName=Root}"
                       Style="{StaticResource GlassHeading3}" />
            <Button Style="{StaticResource GlassIconButton}"
                    Command="{Binding CancelCommand, ElementName=Root}"
                    HorizontalAlignment="Right"
                    Width="24"
                    Height="24">
                <TextBlock FontFamily="{DynamicResource GlassIconFontFamily}"
                           FontSize="12"
                           Text="{x:Static controls:FluentIcons.Close}"
                           Foreground="{DynamicResource GlassMutedForegroundBrush}" />
            </Button>
        </Grid>

        <!-- Selection Preview List -->
        <StackPanel Margin="0,0,0,12">
            <TextBlock Margin="0,0,0,4">
                <TextBlock.Style>
                    <Style TargetType="TextBlock" BasedOn="{StaticResource GlassCaption}">
                        <Setter Property="Text" Value="Selected Dates" />
                        <Style.Triggers>
                            <DataTrigger Binding="{Binding IsEditMode, ElementName=Root}" Value="True">
                                <Setter Property="Text" Value="Current Date(s)" />
                            </DataTrigger>
                        </Style.Triggers>
                    </Style>
                </TextBlock.Style>
            </TextBlock>
            <ItemsControl ItemsSource="{Binding DetectedSelections, ElementName=Root}">
                <ItemsControl.ItemTemplate>
                    <DataTemplate>
                        <Border Background="{DynamicResource GlassMutedBrush}"
                                CornerRadius="4"
                                Padding="8,4"
                                Margin="0,0,0,4">
                            <TextBlock Text="{Binding DisplayText}"
                                       FontSize="12"
                                       Foreground="{DynamicResource GlassForegroundBrush}" />
                        </Border>
                    </DataTemplate>
                </ItemsControl.ItemTemplate>
            </ItemsControl>
        </StackPanel>

        <!-- Description Field -->
        <StackPanel Margin="0,0,0,12">
            <TextBlock Text="Description" Style="{StaticResource GlassCaption}" Margin="0,0,0,4" />
            <TextBox Text="{Binding Description, ElementName=Root, UpdateSourceTrigger=PropertyChanged, Mode=TwoWay}"
                     Style="{StaticResource GlassTextBox}" />
        </StackPanel>

        <!-- Recurring Toggle -->
        <CheckBox IsChecked="{Binding IsRecurring, ElementName=Root, Mode=TwoWay}"
                  Content="Make this recurring"
                  Style="{StaticResource GlassCheckBox}"
                  Margin="0,0,0,12" />

        <!-- Recurring Options -->
        <StackPanel Visibility="{Binding IsRecurring, ElementName=Root, Converter={StaticResource BooleanToVisibilityConverter}}"
                    Margin="0,0,0,12">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="8" />
                    <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>

                <controls:ValidatedNumericInput
                    Grid.Column="0"
                    Label="Repeat after (days)"
                    Value="{Binding Frequency, ElementName=Root, Mode=TwoWay}"
                    ValidationError="{Binding FrequencyError, ElementName=Root}" />

                <controls:ValidatedNumericInput
                    Grid.Column="2"
                    Label="Repetitions"
                    Value="{Binding Repetitions, ElementName=Root, Mode=TwoWay}"
                    ValidationError="{Binding RepetitionsError, ElementName=Root}" />
            </Grid>
        </StackPanel>

        <!-- Action Buttons -->
        <Grid>
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>

            <!-- Delete Button (only in edit mode) -->
            <Button Grid.Column="0"
                    Style="{StaticResource GlassDestructiveButton}"
                    Command="{Binding DeleteCommand, ElementName=Root}"
                    Visibility="{Binding IsEditMode, ElementName=Root, Converter={StaticResource BooleanToVisibilityConverter}}"
                    Content="Delete"
                    Width="80"
                    HorizontalAlignment="Left" />

            <Button Grid.Column="1"
                    Style="{StaticResource GlassGhostButton}"
                    Command="{Binding CancelCommand, ElementName=Root}"
                    Content="Cancel"
                    Width="80"
                    Margin="0,0,8,0" />

            <Button Grid.Column="2"
                    Style="{StaticResource GlassPrimaryButton}"
                    Command="{Binding SaveCommand, ElementName=Root}"
                    Content="Save"
                    Width="80" />
        </Grid>
    </StackPanel>
</UserControl>
