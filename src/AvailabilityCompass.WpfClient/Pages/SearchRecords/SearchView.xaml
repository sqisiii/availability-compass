<UserControl
    x:Class="AvailabilityCompass.WpfClient.Pages.SearchView"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:converters="clr-namespace:AvailabilityCompass.WpfClient.Pages.SearchRecords.Converters"
    xmlns:controls="clr-namespace:AvailabilityCompass.WpfClient.Pages.SearchRecords.Controls"
    xmlns:sharedControls="clr-namespace:AvailabilityCompass.WpfClient.Shared.Controls"
    xmlns:sharedConverters="clr-namespace:AvailabilityCompass.WpfClient.Shared.Converters"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    xmlns:viewModels="clr-namespace:AvailabilityCompass.Core.Features.SearchRecords;assembly=AvailabilityCompass.Core"
    xmlns:helpers="clr-namespace:AvailabilityCompass.WpfClient.Shared.Helpers"
    xmlns:vwp="clr-namespace:WpfToolkit.Controls;assembly=VirtualizingWrapPanel"
    xmlns:guidely="clr-namespace:Guidely.WPF;assembly=Guidely.WPF"
    d:DataContext="{d:DesignInstance viewModels:SearchViewModel,
                                     IsDesignTimeCreatable=True}"
    d:DesignHeight="600"
    d:DesignWidth="800"
    mc:Ignorable="d">
    <UserControl.Resources>
        <converters:FormGroupVisibilityConverter x:Key="VisibilityConverter" />
        <converters:StringToBoolConverter x:Key="StringToBoolConverter" />
        <converters:CalendarTypeToIconConverter x:Key="CalendarTypeToIconConverter" />
        <converters:CalendarTypeToStyleConverter x:Key="CalendarTypeToStyleConverter" />
        <converters:CalendarTypeToColorConverter x:Key="CalendarTypeToColorConverter" />
        <converters:DictionaryToCalendarOverlapsConverter x:Key="CalendarOverlapsConverter" />
        <sharedConverters:BooleanToVisibilityConverter x:Key="InverseBooleanToVisibilityConverter" Invert="True" />
        <converters:ContainerWidthToCardWidthConverter x:Key="CardWidthConverter" CardsPerRow="4" CardMargin="8"
                                                       MinCardWidth="180" />
        <converters:DictionaryToAdditionalFieldsConverter x:Key="AdditionalFieldsConverter" />
        <BooleanToVisibilityConverter x:Key="BooleanToVisibilityConverter" />
        <SolidColorBrush x:Key="GlassConflictTintBrush"
                         Color="{DynamicResource GlassDestructiveColor}"
                         Opacity="0.12" />
        <Style x:Key="GlassIconToggleButton" TargetType="ToggleButton">
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="Foreground" Value="{DynamicResource GlassForegroundBrush}" />
            <Setter Property="Width" Value="36" />
            <Setter Property="Height" Value="36" />
            <Setter Property="Padding" Value="6" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="FocusVisualStyle" Value="{x:Null}" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ToggleButton">
                        <Border x:Name="PART_Border"
                                Background="{TemplateBinding Background}"
                                CornerRadius="{DynamicResource GlassRadius}"
                                Width="{TemplateBinding Width}"
                                Height="{TemplateBinding Height}"
                                SnapsToDevicePixels="True">
                            <ContentPresenter HorizontalAlignment="Center"
                                              VerticalAlignment="Center" />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="PART_Border" Property="Background"
                                        Value="{DynamicResource GlassMutedBrush}" />
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="PART_Border" Property="Background"
                                        Value="{DynamicResource GlassInputBorderBrush}" />
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter TargetName="PART_Border" Property="Opacity" Value="0.5" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
        <!-- ReSharper disable once Xaml.RedundantResource -->
        <DataTemplate x:Key="UrlCellTemplate">
            <!-- ReSharper disable Xaml.BindingWithContextNotResolved -->
            <Button Style="{StaticResource GlassIconButton}"
                    Click="UrlIcon_Click"
                    Tag="{Binding [Url]}"
                    ToolTip="{Binding [Url]}"
                    HorizontalAlignment="Center">
                <sharedControls:FluentIcon Glyph="{x:Static sharedControls:FluentIcons.Link}" IconSize="16"
                                           Foreground="{DynamicResource GlassPrimaryBrush}" />
            </Button>
        </DataTemplate>
    </UserControl.Resources>
    <Border Style="{StaticResource GlassCard}"
            Margin="5"
            Padding="5,5,5,15">
        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="*" />
            </Grid.RowDefinitions>

            <!-- Header -->
            <TextBlock Grid.Row="0"
                       Style="{StaticResource GlassHeading3}"
                       Margin="0,10,0,10"
                       Text="Search"
                       HorizontalAlignment="Center" />

            <!-- Main content area with overlay -->
            <Grid Grid.Row="1">
                <!-- Layer 0: Base layout (headers with search button, results) -->
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="50" />
                        <RowDefinition Height="*" />
                    </Grid.RowDefinitions>

                    <!-- Headers and Search Button in single row -->
                    <Grid Grid.Row="0">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>

                        <!-- Calendars Header with dual-chip support -->
                        <Border Grid.Column="0" CornerRadius="8" Padding="4"
                                guidely:TutorialTarget.Element="CalendarFilterSection">
                            <ToggleButton IsChecked="{Binding IsCalendarsSectionExpanded, Mode=TwoWay}"
                                          Background="Transparent"
                                          BorderThickness="0"
                                          Cursor="Hand"
                                          HorizontalContentAlignment="Stretch"
                                          MinHeight="36"
                                          Padding="0,8">
                                <ToggleButton.Template>
                                    <ControlTemplate TargetType="ToggleButton">
                                        <Border Background="{TemplateBinding Background}"
                                                Padding="{TemplateBinding Padding}"
                                                CornerRadius="4">
                                            <ContentPresenter HorizontalAlignment="Stretch" VerticalAlignment="Center" />
                                        </Border>
                                        <ControlTemplate.Triggers>
                                            <Trigger Property="IsMouseOver" Value="True">
                                                <Setter Property="Background" Value="{DynamicResource GlassMutedBrush}" />
                                            </Trigger>
                                        </ControlTemplate.Triggers>
                                    </ControlTemplate>
                                </ToggleButton.Template>
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="Auto" />
                                        <ColumnDefinition Width="Auto" />
                                        <ColumnDefinition Width="*" />
                                    </Grid.ColumnDefinitions>

                                    <!-- Expand/Collapse Icon -->
                                    <sharedControls:FluentIcon x:Name="ExpandIcon"
                                                               Grid.Column="0"
                                                               Glyph="{x:Static sharedControls:FluentIcons.ChevronDown}"
                                                               IconSize="12"
                                                               Foreground="{DynamicResource GlassMutedForegroundBrush}"
                                                               Margin="0,0,8,0"
                                                               RenderTransformOrigin="0.5,0.5">
                                        <sharedControls:FluentIcon.Style>
                                            <Style TargetType="sharedControls:FluentIcon">
                                                <Setter Property="RenderTransform">
                                                    <Setter.Value>
                                                        <RotateTransform Angle="0" />
                                                    </Setter.Value>
                                                </Setter>
                                                <Style.Triggers>
                                                    <DataTrigger Binding="{Binding IsCalendarsSectionExpanded}"
                                                                 Value="False">
                                                        <Setter Property="RenderTransform">
                                                            <Setter.Value>
                                                                <RotateTransform Angle="-90" />
                                                            </Setter.Value>
                                                        </Setter>
                                                    </DataTrigger>
                                                </Style.Triggers>
                                            </Style>
                                        </sharedControls:FluentIcon.Style>
                                    </sharedControls:FluentIcon>

                                    <!-- Section Title -->
                                    <TextBlock Grid.Column="1"
                                               Text="Calendars"
                                               Style="{StaticResource GlassBody}"
                                               FontWeight="SemiBold"
                                               VerticalAlignment="Center" />

                                    <!-- Summary Chips (visible when collapsed) -->
                                    <StackPanel Grid.Column="2" Orientation="Horizontal" Margin="12,0,0,0"
                                                Visibility="{Binding IsCalendarsSectionExpanded, Converter={StaticResource InverseBooleanToVisibilityConverter}}">
                                        <!-- Green chip for Available days -->
                                        <Border Background="{DynamicResource GlassSuccessBrush}"
                                                Visibility="{Binding HasAvailableDaysSelected, Converter={StaticResource BooleanToVisibilityConverter}}"
                                                CornerRadius="12" Padding="12,4" Margin="0,0,4,0">
                                            <TextBlock Text="{Binding AvailableDaysSummary}"
                                                       Style="{StaticResource GlassCaption}"
                                                       Foreground="{DynamicResource GlassForegroundBrush}"
                                                       FontWeight="SemiBold"
                                                       MaxWidth="200"
                                                       TextTrimming="CharacterEllipsis" />
                                        </Border>
                                        <!-- Amber chip for Blocked days -->
                                        <Border Background="{DynamicResource GlassPrimaryBrush}"
                                                Visibility="{Binding HasBlockedDaysSelected, Converter={StaticResource BooleanToVisibilityConverter}}"
                                                CornerRadius="12" Padding="12,4">
                                            <TextBlock Text="{Binding BlockedDaysSummary}"
                                                       Style="{StaticResource GlassCaption}"
                                                       Foreground="{DynamicResource GlassForegroundBrush}"
                                                       FontWeight="SemiBold"
                                                       MaxWidth="200"
                                                       TextTrimming="CharacterEllipsis" />
                                        </Border>
                                        <!-- Gray chip when none selected -->
                                        <Border Background="{DynamicResource GlassMutedBrush}"
                                                Visibility="{Binding HasCalendarsSelected, Converter={StaticResource InverseBooleanToVisibilityConverter}}"
                                                CornerRadius="12" Padding="12,4">
                                            <TextBlock Text="None selected"
                                                       Style="{StaticResource GlassCaption}"
                                                       Foreground="{DynamicResource GlassForegroundBrush}"
                                                       MaxWidth="200"
                                                       TextTrimming="CharacterEllipsis" />
                                        </Border>
                                    </StackPanel>
                                </Grid>
                            </ToggleButton>
                        </Border>

                        <Rectangle Grid.Column="1" Style="{StaticResource GlassVerticalSeparator}" />

                        <!-- Sources Header -->
                        <sharedControls:CollapsibleSection
                            Grid.Column="2"
                            Header="Sources"
                            Summary="{Binding SourcesSummary}"
                            HasSelection="{Binding HasSourcesSelected}"
                            IsExpanded="{Binding IsSourcesSectionExpanded, Mode=TwoWay}"
                            guidely:TutorialTarget.Element="SourcesFilterSection" />

                        <Rectangle Grid.Column="3" Style="{StaticResource GlassVerticalSeparator}" />

                        <!-- Global Filters Header -->
                        <sharedControls:CollapsibleSection
                            Grid.Column="4"
                            Header="Filters"
                            Summary="{Binding FiltersSummary}"
                            HasSelection="{Binding HasFiltersSet}"
                            IsExpanded="{Binding IsFiltersSectionExpanded, Mode=TwoWay}"
                            guidely:TutorialTarget.Element="FiltersSection" />

                        <!-- Search Button -->
                        <Button
                            Grid.Column="5"
                            Width="120"
                            Command="{Binding SearchCommand}"
                            Content="Search"
                            Margin="15,0,0,0"
                            VerticalAlignment="Center"
                            Style="{StaticResource GlassPrimaryButton}"
                            guidely:TutorialTarget.Element="SearchButton" />
                    </Grid>

                    <!-- Results Section - Fills remaining space -->
                    <DockPanel Grid.Row="1"
                               Visibility="{Binding HasResults, Converter={StaticResource BooleanToVisibilityConverter}}"
                               guidely:TutorialTarget.Element="ResultsSection">
                        <!-- Header with count and sort dropdown -->
                        <Grid DockPanel.Dock="Top" Margin="0,10,0,10">
                            <TextBlock Text="{Binding Results.Count, StringFormat='Results ({0})'}"
                                       Style="{StaticResource GlassBody}"
                                       FontWeight="SemiBold"
                                       VerticalAlignment="Center" />
                            <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                                <TextBlock Text="Sort by:"
                                           Style="{StaticResource GlassCaption}"
                                           VerticalAlignment="Center"
                                           Margin="0,0,8,0" />
                                <ComboBox ItemsSource="{Binding SortOptions}"
                                          SelectedItem="{Binding SelectedSortOption}"
                                          Style="{StaticResource GlassFloatingHintComboBox}"
                                          Width="100" />
                            </StackPanel>
                        </Grid>

                        <!-- Card Grid -->
                        <ListBox x:Name="ResultsListBox"
                                 ItemsSource="{Binding Results}"
                                 SelectedItem="{Binding SelectedResult, Mode=TwoWay}"
                                 Background="Transparent"
                                 BorderThickness="0"
                                 ScrollViewer.HorizontalScrollBarVisibility="Disabled"
                                 ScrollViewer.VerticalScrollBarVisibility="Auto"
                                 VirtualizingPanel.IsVirtualizing="True"
                                 VirtualizingPanel.VirtualizationMode="Recycling"
                                 VirtualizingPanel.ScrollUnit="Pixel">
                            <ListBox.ItemsPanel>
                                <ItemsPanelTemplate>
                                    <vwp:VirtualizingWrapPanel Orientation="Horizontal" />
                                </ItemsPanelTemplate>
                            </ListBox.ItemsPanel>
                            <ListBox.ItemContainerStyle>
                                <Style TargetType="ListBoxItem">
                                    <Setter Property="Padding" Value="0" />
                                    <Setter Property="Margin" Value="0" />
                                    <Setter Property="HorizontalContentAlignment" Value="Stretch" />
                                    <Setter Property="Template">
                                        <Setter.Value>
                                            <ControlTemplate TargetType="ListBoxItem">
                                                <ContentPresenter />
                                            </ControlTemplate>
                                        </Setter.Value>
                                    </Setter>
                                </Style>
                            </ListBox.ItemContainerStyle>
                            <ListBox.ItemTemplate>
                                <DataTemplate>
                                    <!-- Result Card -->
                                    <Border
                                        Width="{Binding ActualWidth, ElementName=ResultsListBox, Converter={StaticResource CardWidthConverter}}"
                                        MinHeight="200"
                                        Margin="8"
                                        CornerRadius="12" Padding="12"
                                        Cursor="Hand"
                                        MouseLeftButtonUp="ResultCard_Click"
                                        Tag="{Binding [Url]}">
                                        <Border.Style>
                                            <Style TargetType="Border">
                                                <Setter Property="Background" Value="{DynamicResource GlassCardBrush}" />
                                                <Setter Property="BorderBrush"
                                                        Value="{DynamicResource GlassBorderSolidBrush}" />
                                                <Setter Property="BorderThickness" Value="1" />
                                                <Style.Triggers>
                                                    <Trigger Property="IsMouseOver" Value="True">
                                                        <Setter Property="Effect">
                                                            <Setter.Value>
                                                                <DropShadowEffect
                                                                    Color="{DynamicResource GlassPrimaryColor}"
                                                                    BlurRadius="14"
                                                                    ShadowDepth="0"
                                                                    Opacity="0.35" />
                                                            </Setter.Value>
                                                        </Setter>
                                                    </Trigger>
                                                    <DataTrigger
                                                        Binding="{Binding IsSelected, RelativeSource={RelativeSource AncestorType=ListBoxItem}}"
                                                        Value="True">
                                                        <Setter Property="BorderBrush"
                                                                Value="{DynamicResource GlassPrimaryBrush}" />
                                                        <Setter Property="BorderThickness" Value="2" />
                                                        <Setter Property="Background"
                                                                Value="{DynamicResource GlassPrimaryLightBrush}" />
                                                    </DataTrigger>
                                                    <DataTrigger Binding="{Binding [HasCalendarOverlaps]}"
                                                                 Value="True">
                                                        <Setter Property="BorderBrush"
                                                                Value="{DynamicResource GlassDestructiveBrush}" />
                                                        <Setter Property="Background"
                                                                Value="{StaticResource GlassConflictTintBrush}" />
                                                        <Setter Property="BorderThickness" Value="2" />
                                                    </DataTrigger>
                                                </Style.Triggers>
                                            </Style>
                                        </Border.Style>

                                        <Grid>
                                            <Grid.RowDefinitions>
                                                <RowDefinition Height="Auto" />
                                                <RowDefinition Height="Auto" />
                                                <RowDefinition Height="Auto" />
                                                <RowDefinition Height="*" />
                                                <RowDefinition Height="Auto" />
                                            </Grid.RowDefinitions>

                                            <!-- Row 0: Source Badge + Language -->
                                            <Grid Grid.Row="0">
                                                <Border Background="{DynamicResource GlassAccentLightBrush}"
                                                        CornerRadius="10"
                                                        Padding="8,2"
                                                        HorizontalAlignment="Left">
                                                    <StackPanel Orientation="Horizontal">
                                                        <Image Source="{Binding [SourceIconPath]}"
                                                               Width="16" Height="16"
                                                               VerticalAlignment="Center"
                                                               Margin="0,0,6,0"
                                                               RenderOptions.BitmapScalingMode="HighQuality" />
                                                        <TextBlock Text="{Binding [SourceName]}"
                                                                   Style="{StaticResource GlassCaption}"
                                                                   FontWeight="SemiBold"
                                                                   VerticalAlignment="Center"
                                                                   Foreground="{DynamicResource GlassAccentBrush}" />
                                                    </StackPanel>
                                                </Border>
                                                <TextBlock Text="{Binding [SourceLanguage]}"
                                                           HorizontalAlignment="Right"
                                                           VerticalAlignment="Center"
                                                           Style="{StaticResource GlassCaption}" />
                                            </Grid>

                                            <!-- Row 1: Info Strip (Destination left, Dates right) -->
                                            <Grid Grid.Row="1" Margin="0,8,0,4">
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="*" />
                                                    <ColumnDefinition Width="Auto" />
                                                </Grid.ColumnDefinitions>
                                                <!-- Destination (left) -->
                                                <StackPanel Grid.Column="0" Orientation="Horizontal">
                                                    <sharedControls:FluentIcon
                                                        Glyph="{x:Static sharedControls:FluentIcons.Location}"
                                                        IconSize="14"
                                                        Margin="0,0,4,0"
                                                        Foreground="{DynamicResource GlassPrimaryBrush}" />
                                                    <TextBlock Text="{Binding [Destination]}"
                                                               Style="{StaticResource GlassSmall}"
                                                               FontWeight="SemiBold"
                                                               TextTrimming="CharacterEllipsis" />
                                                </StackPanel>
                                                <!-- Dates (right) -->
                                                <StackPanel Grid.Column="1" Orientation="Horizontal" Margin="8,0,0,0">
                                                    <sharedControls:FluentIcon
                                                        Glyph="{x:Static sharedControls:FluentIcons.Calendar}"
                                                        IconSize="14"
                                                        Margin="0,0,4,0"
                                                        Foreground="{DynamicResource GlassPrimaryBrush}" />
                                                    <TextBlock Style="{StaticResource GlassSmall}"
                                                               FontWeight="SemiBold">
                                                        <Run Text="{Binding [StartDate], Mode=OneWay}" />
                                                        <Run Text="—"
                                                             Foreground="{DynamicResource GlassMutedForegroundBrush}" />
                                                        <Run Text="{Binding [EndDate], Mode=OneWay}" />
                                                    </TextBlock>
                                                </StackPanel>
                                            </Grid>

                                            <!-- Row 2: Title (multiline, more prominent than additional fields) -->
                                            <TextBlock Grid.Row="2"
                                                       Text="{Binding [Title]}"
                                                       Style="{StaticResource GlassSmall}"
                                                       TextWrapping="Wrap"
                                                       Margin="0,4,0,4" />

                                            <!-- Row 3: Additional Fields (Type, Price, then rest) -->
                                            <ItemsControl Grid.Row="3"
                                                          ItemsSource="{Binding Converter={StaticResource AdditionalFieldsConverter}}">
                                                <ItemsControl.ItemTemplate>
                                                    <DataTemplate>
                                                        <TextBlock Style="{StaticResource GlassCaption}"

                                                                   Margin="0,1">
                                                            <Run Text="{Binding Key, Mode=OneWay}" FontWeight="Medium" />
                                                            <Run Text=": " />
                                                            <Run Text="{Binding Value, Mode=OneWay}" />
                                                        </TextBlock>
                                                    </DataTemplate>
                                                </ItemsControl.ItemTemplate>
                                            </ItemsControl>

                                            <!-- Row 4: Conflicts -->
                                            <StackPanel Grid.Row="4"
                                                        Visibility="{Binding ElementName=ConflictsList, Path=HasItems, Converter={StaticResource BooleanToVisibilityConverter}}">
                                                <TextBlock Text="Conflicts"
                                                           Style="{StaticResource GlassCaption}"
                                                           FontWeight="SemiBold"
                                                           Foreground="{DynamicResource GlassWarningBrush}" />
                                                <ItemsControl x:Name="ConflictsList"
                                                              ItemsSource="{Binding Converter={StaticResource CalendarOverlapsConverter}}">
                                                    <ItemsControl.ItemTemplate>
                                                        <DataTemplate>
                                                            <StackPanel Margin="0,4,0,0">
                                                                <TextBlock Style="{StaticResource GlassCaption}"
                                                                           TextWrapping="Wrap">
                                                                    <Run Text="{Binding CalendarName}"
                                                                         FontWeight="Medium" />
                                                                    <Run Text=": " />
                                                                    <Run Text="{Binding ConflictSummary}" />
                                                                </TextBlock>
                                                            </StackPanel>
                                                        </DataTemplate>
                                                    </ItemsControl.ItemTemplate>
                                                </ItemsControl>
                                            </StackPanel>

                                        </Grid>
                                    </Border>
                                </DataTemplate>
                            </ListBox.ItemTemplate>
                        </ListBox>
                    </DockPanel>

                    <!-- No Results Section -->
                    <StackPanel Grid.Row="1"
                                Visibility="{Binding ShowNoResults, Converter={StaticResource BooleanToVisibilityConverter}}"
                                VerticalAlignment="Center"
                                HorizontalAlignment="Center"
                                guidely:TutorialTarget.Element="NoResultsSection">
                        <TextBlock Text="No matching results found"
                                   Style="{StaticResource GlassBody}"
                                   FontWeight="SemiBold"
                                   HorizontalAlignment="Center" />
                        <TextBlock Text="Try adjusting your filters or calendar settings"
                                   Style="{StaticResource GlassCaption}"
                                   HorizontalAlignment="Center"
                                   Margin="0,4,0,0" />
                    </StackPanel>
                </Grid>

                <!-- Layer 1: Expanded content overlay (renders on top) -->
                <Border Margin="0,50,0,0" VerticalAlignment="Top" CornerRadius="8">
                    <StackPanel>
                        <!-- Full-width Calendars Content -->
                        <Border CornerRadius="8" Padding="12,8" Margin="0,0,0,8"
                                Background="{DynamicResource GlassBackgroundBrush}"
                                Visibility="{Binding IsCalendarsSectionExpanded, Converter={StaticResource BooleanToVisibilityConverter}}">
                            <StackPanel>
                                <StackPanel Orientation="Horizontal"
                                            VerticalAlignment="Center"
                                            Visibility="{Binding CalendarsUnAvailable, Converter={StaticResource BooleanToVisibilityConverter}}">
                                    <TextBlock Text="No calendars available."
                                               Style="{StaticResource GlassBodyMuted}"
                                               VerticalAlignment="Center" />
                                    <Button Content="Add calendars"
                                            Command="{Binding OpenCalendarsCommand}"
                                            Style="{StaticResource GlassLinkButton}"
                                            VerticalAlignment="Center"
                                            Margin="8,0,0,0" />
                                </StackPanel>
                                <ScrollViewer MaxHeight="300" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
                                    <ItemsControl ItemsSource="{Binding Calendars}"
                                                  guidely:TutorialTarget.Element="CalendarCards"
                                                  Visibility="{Binding CalendarsAvailable, Converter={StaticResource BooleanToVisibilityConverter}}">
                                    <ItemsControl.ItemsPanel>
                                        <ItemsPanelTemplate>
                                            <WrapPanel Orientation="Horizontal" />
                                        </ItemsPanelTemplate>
                                    </ItemsControl.ItemsPanel>
                                    <ItemsControl.ItemTemplate>
                                        <DataTemplate DataType="{x:Type viewModels:CalendarFilterViewModel}">
                                            <Grid Margin="0,0,8,8">
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="Auto" />
                                                    <ColumnDefinition Width="Auto" />
                                                </Grid.ColumnDefinitions>
                                                <ToggleButton Grid.Column="0"
                                                              MinWidth="220"
                                                              Padding="12,0,44,0"
                                                              IsChecked="{Binding IsSelected, Mode=TwoWay}"
                                                              Style="{Binding IsOnly, Converter={StaticResource CalendarTypeToStyleConverter}}">
                                                    <Grid>
                                                        <Grid.ColumnDefinitions>
                                                            <ColumnDefinition Width="Auto" />
                                                            <ColumnDefinition Width="*" />
                                                        </Grid.ColumnDefinitions>
                                                        <sharedControls:FluentIcon
                                                            Grid.Column="0"
                                                            Glyph="{Binding IsOnly, Converter={StaticResource CalendarTypeToIconConverter}}"
                                                            IconSize="24"
                                                            VerticalAlignment="Center"
                                                            Foreground="{Binding IsOnly, Converter={StaticResource CalendarTypeToColorConverter}}" />
                                                        <StackPanel Grid.Column="1" Margin="10,0,0,0"
                                                                    VerticalAlignment="Center">
                                                            <TextBlock Text="{Binding Name}"
                                                                       FontWeight="Medium"
                                                                       FontSize="13"
                                                                       TextTrimming="CharacterEllipsis" />
                                                            <TextBlock Text="{Binding Type}"
                                                                       Style="{StaticResource GlassCaption}"
                                                                       Margin="0,2,0,0" />
                                                        </StackPanel>
                                                    </Grid>
                                                </ToggleButton>
                                                <ToggleButton Grid.Column="1"
                                                              IsChecked="{Binding IsMarkOnly, Mode=TwoWay}"
                                                              Style="{StaticResource GlassIconToggleButton}"
                                                              Width="28"
                                                              Height="28"
                                                              Margin="-36,6,6,0"
                                                              HorizontalAlignment="Right"
                                                              VerticalAlignment="Top"
                                                              ToolTip="Toggle mark-only (no filtering)">
                                                    <TextBlock FontWeight="Bold"
                                                               FontSize="14"
                                                               VerticalAlignment="Center"
                                                               HorizontalAlignment="Center">
                                                        <TextBlock.Style>
                                                            <Style TargetType="TextBlock">
                                                                <Setter Property="Text" Value="F" />
                                                                <Setter Property="Foreground"
                                                                        Value="{DynamicResource GlassPrimaryBrush}" />
                                                                <Style.Triggers>
                                                                    <DataTrigger Binding="{Binding IsMarkOnly}"
                                                                            Value="True">
                                                                        <Setter Property="Text" Value="M" />
                                                                        <Setter Property="Foreground"
                                                                                Value="{DynamicResource GlassWarningBrush}" />
                                                                    </DataTrigger>
                                                                </Style.Triggers>
                                                            </Style>
                                                        </TextBlock.Style>
                                                    </TextBlock>
                                                </ToggleButton>
                                            </Grid>
                                        </DataTemplate>
                                    </ItemsControl.ItemTemplate>
                                    </ItemsControl>
                                </ScrollViewer>
                            </StackPanel>
                        </Border>

                        <!-- Full-width Sources Content -->
                        <Border CornerRadius="8" Padding="12,8" Margin="0,0,0,8"
                                Background="{DynamicResource GlassBackgroundBrush}"
                                Visibility="{Binding IsSourcesSectionExpanded, Converter={StaticResource BooleanToVisibilityConverter}}">
                            <StackPanel>
                                <StackPanel Orientation="Horizontal"
                                            VerticalAlignment="Center"
                                            Visibility="{Binding SourcesUnAvailable, Converter={StaticResource BooleanToVisibilityConverter}}">
                                    <TextBlock Text="No sources available."
                                               Style="{StaticResource GlassBodyMuted}"
                                               VerticalAlignment="Center" />
                                    <Button Content="Add sources"
                                            Command="{Binding OpenSourcesCommand}"
                                            Style="{StaticResource GlassLinkButton}"
                                            VerticalAlignment="Center"
                                            Margin="8,0,0,0" />
                                </StackPanel>
                                <!-- Source cards -->
                                <ScrollViewer MaxHeight="300" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
                                    <ItemsControl ItemsSource="{Binding Sources}"
                                                  guidely:TutorialTarget.Element="SourceCards"
                                                  Visibility="{Binding SourcesAvailable, Converter={StaticResource BooleanToVisibilityConverter}}">
                                    <ItemsControl.ItemsPanel>
                                        <ItemsPanelTemplate>
                                            <WrapPanel Orientation="Horizontal" />
                                        </ItemsPanelTemplate>
                                    </ItemsControl.ItemsPanel>
                                    <ItemsControl.ItemTemplate>
                                        <DataTemplate DataType="{x:Type viewModels:SourceFilterViewModel}">
                                            <ToggleButton Margin="0,0,8,8"
                                                          IsChecked="{Binding IsSelected, Mode=TwoWay}"
                                                          IsEnabled="{Binding IsInteractable}"
                                                          ToolTip="{Binding Tooltip}"
                                                          ToolTipService.ShowOnDisabled="True"
                                                          Style="{StaticResource GlassFloatingCardSource}">
                                                <StackPanel Orientation="Horizontal" VerticalAlignment="Center"
                                                            Margin="12,0">
                                                    <Image Source="{Binding IconPath}"
                                                           Width="24" Height="24"
                                                           VerticalAlignment="Center"
                                                           RenderOptions.BitmapScalingMode="HighQuality" />
                                                    <StackPanel Margin="10,0,0,0" VerticalAlignment="Center">
                                                        <TextBlock Text="{Binding Name}"
                                                                   FontWeight="Medium"
                                                                   FontSize="13" />
                                                        <TextBlock Text="{Binding Language}"
                                                                   Style="{StaticResource GlassCaption}"
                                                                   Margin="0,2,0,0" />
                                                    </StackPanel>
                                                </StackPanel>
                                            </ToggleButton>
                                        </DataTemplate>
                                    </ItemsControl.ItemTemplate>
                                    </ItemsControl>
                                </ScrollViewer>
                                <!-- Source filters (separate from cards) -->
                                <ItemsControl ItemsSource="{Binding Sources}"
                                              Visibility="{Binding SourcesAvailable, Converter={StaticResource BooleanToVisibilityConverter}}"
                                              guidely:TutorialTarget.Element="SourceFilterOptions">
                                    <ItemsControl.ItemTemplate>
                                        <DataTemplate DataType="{x:Type viewModels:SourceFilterViewModel}">
                                            <Border Style="{StaticResource GlassNestedFilterPanel}"
                                                    Margin="0,4,0,0"
                                                    Visibility="{Binding IsSelected, Converter={StaticResource BooleanToVisibilityConverter}}">
                                                <StackPanel
                                                    Visibility="{Binding HasFilters, Converter={StaticResource BooleanToVisibilityConverter}}">
                                                    <TextBlock Text="{Binding Name, StringFormat='{}{0} filters:'}"
                                                               Style="{StaticResource GlassCaption}"
                                                               FontWeight="SemiBold"
                                                               Margin="0,0,0,8" />
                                                    <ItemsControl ItemsSource="{Binding FilterFormGroup.Elements}">
                                                        <ItemsControl.ItemsPanel>
                                                            <ItemsPanelTemplate>
                                                                <WrapPanel Orientation="Horizontal" />
                                                            </ItemsPanelTemplate>
                                                        </ItemsControl.ItemsPanel>
                                                        <ItemsControl.ItemTemplate>
                                                            <DataTemplate>
                                                                <StackPanel Margin="0,0,15,5" Orientation="Horizontal">
                                                                    <TextBox
                                                                        Width="100"
                                                                        helpers:GlassHint.Hint="{Binding Label}"
                                                                        Style="{StaticResource GlassFloatingHintTextBox}"
                                                                        Text="{Binding TextValue, UpdateSourceTrigger=PropertyChanged, Mode=TwoWay}"
                                                                        Visibility="{Binding Type, Converter={StaticResource VisibilityConverter}, ConverterParameter=TextBox}"
                                                                        ToolTip="{Binding Label}" />
                                                                    <CheckBox
                                                                        Content="{Binding Label}"
                                                                        Visibility="{Binding Type, Converter={StaticResource VisibilityConverter}, ConverterParameter=CheckBox}"
                                                                        IsChecked="{Binding TextValue, Converter={StaticResource StringToBoolConverter}, Mode=TwoWay}"
                                                                        Style="{StaticResource GlassCheckBox}"
                                                                        ToolTip="{Binding Label}" />
                                                                    <StackPanel Orientation="Horizontal"
                                                                            Visibility="{Binding Type, Converter={StaticResource VisibilityConverter}, ConverterParameter=MultiSelect}">
                                                                        <TextBlock
                                                                            Text="{Binding Label, StringFormat='{}{0}:'}"
                                                                            Style="{StaticResource GlassCaption}"
                                                                            VerticalAlignment="Center"
                                                                            Margin="0,0,8,0" />
                                                                        <controls:MultiSelectComboBoxView
                                                                            ItemSource="{Binding Options}"
                                                                            Label="{Binding Label}"
                                                                            SelectedItems="{Binding SelectedOptions}" />
                                                                    </StackPanel>
                                                                </StackPanel>
                                                            </DataTemplate>
                                                        </ItemsControl.ItemTemplate>
                                                    </ItemsControl>
                                                </StackPanel>
                                            </Border>
                                        </DataTemplate>
                                    </ItemsControl.ItemTemplate>
                                </ItemsControl>
                            </StackPanel>
                        </Border>

                        <!-- Full-width Global Filters Content -->
                        <Border CornerRadius="8" Padding="12,8" Margin="0,0,0,8"
                                Background="{DynamicResource GlassBackgroundBrush}"
                                Visibility="{Binding IsFiltersSectionExpanded, Converter={StaticResource BooleanToVisibilityConverter}}">
                            <StackPanel Orientation="Horizontal"
                                        guidely:TutorialTarget.Element="GlobalFilterFields">
                                <TextBox
                                    Width="200"
                                    helpers:GlassHint.Hint="Search phrase"
                                    Style="{StaticResource GlassFloatingHintTextBox}"
                                    Text="{Binding SearchPhrase, UpdateSourceTrigger=PropertyChanged, Mode=TwoWay}"
                                    ToolTip="Phrase to look for." />
                                <TextBlock Text="Start Date:"
                                           Style="{StaticResource GlassCaption}"
                                           VerticalAlignment="Center"
                                           Margin="15,0,8,0" />
                                <DatePicker
                                    Width="120"
                                    Style="{StaticResource GlassDatePicker}"
                                    Text="{Binding StartDate, ValidatesOnDataErrors=True, UpdateSourceTrigger=PropertyChanged, Mode=TwoWay, StringFormat=yyyy-MM-dd}"
                                    ToolTip="Start Date" />
                                <TextBlock Text="End Date:"
                                           Style="{StaticResource GlassCaption}"
                                           VerticalAlignment="Center"
                                           Margin="15,0,8,0" />
                                <DatePicker
                                    Width="120"
                                    Style="{StaticResource GlassDatePicker}"
                                    Text="{Binding EndDate, ValidatesOnDataErrors=True, UpdateSourceTrigger=PropertyChanged, Mode=TwoWay, StringFormat=yyyy-MM-dd}"
                                    ToolTip="End Date" />
                            </StackPanel>
                        </Border>
                    </StackPanel>
                </Border>
            </Grid>
        </Grid>
    </Border>
</UserControl>