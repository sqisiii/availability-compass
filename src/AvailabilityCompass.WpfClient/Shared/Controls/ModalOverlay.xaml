<UserControl x:Class="AvailabilityCompass.WpfClient.Shared.Controls.ModalOverlay"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             x:Name="Root">
    <UserControl.Resources>
        <BooleanToVisibilityConverter x:Key="BooleanToVisibilityConverter" />
    </UserControl.Resources>
    <Border Background="#80000000"
            Visibility="{Binding IsOpen, ElementName=Root, Converter={StaticResource BooleanToVisibilityConverter}}">
        <Border Background="{DynamicResource GlassCardSolidBrush}"
                BorderBrush="{DynamicResource GlassBorderSolidBrush}"
                BorderThickness="1"
                CornerRadius="12"
                Padding="20"
                MinWidth="{Binding MinDialogWidth, ElementName=Root}"
                MaxWidth="{Binding MaxDialogWidth, ElementName=Root}"
                VerticalAlignment="Center"
                HorizontalAlignment="Center"
                Effect="{DynamicResource GlassShadowMD}">
            <ContentPresenter Content="{Binding DialogContent, ElementName=Root}" />
        </Border>
    </Border>
</UserControl>
