<UserControl x:Class="Guidely.WPF.Controls.TutorialOverlay"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:controls="clr-namespace:Guidely.WPF.Controls"
             mc:Ignorable="d"
             d:DesignHeight="600"
             d:DesignWidth="800">

    <UserControl.Resources>
        <BooleanToVisibilityConverter x:Key="BooleanToVisibilityConverter" />

        <!-- Default styles that can be overridden by consumers -->
        <SolidColorBrush x:Key="GuidelyBackdropBrush" Color="#40000000" />
        <SolidColorBrush x:Key="GuidelyTooltipBackgroundBrush" Color="#FFFFFF" />
        <SolidColorBrush x:Key="GuidelyTooltipBorderBrush" Color="#3B82F6" />
        <SolidColorBrush x:Key="GuidelyPrimaryBrush" Color="#3B82F6" />
        <SolidColorBrush x:Key="GuidelyTextBrush" Color="#1F2937" />
        <SolidColorBrush x:Key="GuidelyMutedTextBrush" Color="#6B7280" />
    </UserControl.Resources>

    <!-- The main overlay grid - covers an entire window -->
    <Grid x:Name="OverlayRoot"
          Visibility="{Binding IsVisible, Converter={StaticResource BooleanToVisibilityConverter}}">

        <!-- Semi-transparent backdrop with selective click-through -->
        <controls:SelectiveHitTestBorder x:Name="Backdrop"
                                         Background="{DynamicResource GuidelyBackdropBrush}"
                                         ClickThroughMode="{Binding ClickThroughMode}" />

        <!-- Tooltip Popup - positioned via code-behind -->
        <Border x:Name="TooltipBorder"
                Background="{DynamicResource GuidelyTooltipBackgroundBrush}"
                BorderBrush="{DynamicResource GuidelyTooltipBorderBrush}"
                BorderThickness="2"
                CornerRadius="12"
                Padding="20"
                MaxWidth="400"
                MinWidth="300"
                HorizontalAlignment="Left"
                VerticalAlignment="Top">
            <Border.Effect>
                <DropShadowEffect BlurRadius="20" ShadowDepth="4" Opacity="0.2" Color="#000000" />
            </Border.Effect>
            <StackPanel>
                <!-- Header with title and close button -->
                <Grid Margin="0,0,0,12">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>

                    <TextBlock Grid.Column="0"
                               Text="{Binding Title}"
                               FontSize="18"
                               FontWeight="SemiBold"
                               Foreground="{DynamicResource GuidelyTextBrush}"
                               TextWrapping="Wrap" />

                    <Button Grid.Column="1"
                            Command="{Binding SkipCommand}"
                            ToolTip="Skip tutorial"
                            Width="28"
                            Height="28"
                            Margin="-8,-8,0,0"
                            VerticalAlignment="Top"
                            Background="Transparent"
                            BorderThickness="0"
                            Cursor="Hand">
                        <TextBlock Text="✕" FontSize="14" Foreground="{DynamicResource GuidelyMutedTextBrush}" />
                    </Button>
                </Grid>

                <!-- Description -->
                <TextBlock Text="{Binding Description}"
                           FontSize="14"
                           Foreground="{DynamicResource GuidelyTextBrush}"
                           Margin="0,0,0,16"
                           LineHeight="22"
                           TextWrapping="Wrap" />

                <!-- Footer with progress and buttons -->
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>

                    <!-- Progress indicator -->
                    <TextBlock Grid.Column="0"
                               Text="{Binding StepProgress}"
                               FontSize="12"
                               Foreground="{DynamicResource GuidelyMutedTextBrush}"
                               VerticalAlignment="Center" />

                    <!-- Back button -->
                    <Button Grid.Column="1"
                            Content="Back"
                            Command="{Binding BackCommand}"
                            Visibility="{Binding CanGoBack, Converter={StaticResource BooleanToVisibilityConverter}}"
                            Margin="0,0,8,0"
                            Padding="12,6"
                            Background="Transparent"
                            BorderBrush="{DynamicResource GuidelyMutedTextBrush}"
                            BorderThickness="1"
                            Foreground="{DynamicResource GuidelyTextBrush}"
                            Cursor="Hand">
                        <Button.Template>
                            <ControlTemplate TargetType="Button">
                                <Border Background="{TemplateBinding Background}"
                                        BorderBrush="{TemplateBinding BorderBrush}"
                                        BorderThickness="{TemplateBinding BorderThickness}"
                                        CornerRadius="6"
                                        Padding="{TemplateBinding Padding}">
                                    <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
                                </Border>
                            </ControlTemplate>
                        </Button.Template>
                    </Button>

                    <!-- Next/Finish button -->
                    <Button Grid.Column="2"
                            Content="{Binding NextButtonText}"
                            Command="{Binding NextCommand}"
                            Visibility="{Binding ShowNextButton, Converter={StaticResource BooleanToVisibilityConverter}}"
                            Padding="16,6"
                            Background="{DynamicResource GuidelyPrimaryBrush}"
                            BorderThickness="0"
                            Foreground="White"
                            Cursor="Hand">
                        <Button.Template>
                            <ControlTemplate TargetType="Button">
                                <Border Background="{TemplateBinding Background}"
                                        BorderBrush="{TemplateBinding BorderBrush}"
                                        BorderThickness="{TemplateBinding BorderThickness}"
                                        CornerRadius="6"
                                        Padding="{TemplateBinding Padding}">
                                    <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
                                </Border>
                            </ControlTemplate>
                        </Button.Template>
                    </Button>
                </Grid>

                <!-- Hint for action-required steps -->
                <TextBlock x:Name="ActionHint"
                           Text="👆 Perform the action above to continue"
                           FontSize="12"
                           Foreground="{DynamicResource GuidelyPrimaryBrush}"
                           FontStyle="Italic"
                           Margin="0,12,0,0"
                           HorizontalAlignment="Center"
                           Visibility="Collapsed" />
            </StackPanel>
        </Border>
    </Grid>
</UserControl>